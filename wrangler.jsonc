{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noahairmet-com",
  "compatibility_date": "2026-07-12",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "noahairmet.com",
      "custom_domain": true
    },
    {
      "pattern": "www.noahairmet.com",
      "custom_domain": true
    }
  ],
  "main": "worker/index.js",
  // Latest outdoor activity for the About page (worker/last-out.js).
  // The Ledger upload token is a secret: `wrangler secret put LAST_OUT_TOKEN`.
  "kv_namespaces": [{ "binding": "LAST_OUT", "id": "9123fd4eabbf4abaaaa1a2376e7447fd" }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/og/*", "/api/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}

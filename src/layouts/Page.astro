---
import "../styles/tokens.css";
import "../styles/base.css";
import flex from "../fonts/roboto-flex.woff2?url";
import { absoluteUrl, pageTitle, site } from "../site";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
  here?: "home" | "writing";
}

const { title, description = site.description, path = "/", noindex = false, here } = Astro.props;
const fullTitle = pageTitle(title);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={absoluteUrl(path)} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}: writing`} href={absoluteUrl("/rss.xml")} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absoluteUrl(path)} />
    <meta property="og:image" content={absoluteUrl(site.card.image)} />
    <meta property="og:image:width" content={String(site.card.width)} />
    <meta property="og:image:height" content={String(site.card.height)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@AirmetNoah" />
    <meta name="twitter:image" content={absoluteUrl(site.card.image)} />
    <meta name="theme-color" content="#ecede8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1a3c" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href={flex} as="font" type="font/woff2" crossorigin />
    {here === "home" && <script is:inline src="/boot.js" />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="bar">
      <nav aria-label="Site">
        {here !== "home" && <a class="home" href="/">Noah Airmet</a>}
        <a href="/#work">Work</a>
        <a href="/writing/" aria-current={here === "writing" ? "page" : undefined}>Writing</a>
        <a href="/#outside">Outside</a>
      </nav>
      <slot name="bar" />
    </header>
    <slot />
  </body>
</html>

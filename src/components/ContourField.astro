---
/**
 * Real-terrain contour artwork: each mountain floats as a compact figure
 * near a viewport corner. Path data comes from USGS 10m elevation grids
 * via scripts/generate-contours.mjs. The contour wash (lines + trail) is
 * CSS-masked so it dissolves in every direction; the summit cross and
 * label sit outside the mask and stay crisp. Lines draw once on load;
 * the dashed summit trail crawls slowly uphill forever. All CSS, no JS.
 */
import { kingsPeak, lonePeak, timpanogos, type ContourSet } from "../lib/contours";

interface Props {
  mountain?: "timpanogos" | "lonePeak" | "kingsPeak";
  place?: "tr" | "bl";
  labeled?: boolean;
  /** Label anchor as viewBox fractions; defaults to just right of the summit. */
  labelPos?: [number, number];
  class?: string;
}

const sets: Record<string, ContourSet> = { timpanogos, lonePeak, kingsPeak };
const {
  mountain = "timpanogos",
  place = mountain === "timpanogos" ? "tr" : "bl",
  labeled = true,
  labelPos,
  class: className,
} = Astro.props;
const set = sets[mountain];
const peakX = Number(set.peak[0]);
const peakY = Number(set.peak[1]);
const [, , vbW, vbH] = set.viewBox.split(" ").map(Number);
const labelX = labelPos ? labelPos[0] * vbW : peakX + 16;
const labelY = labelPos ? labelPos[1] * vbH : peakY + 5;
---

<svg
  class:list={["contour-field", `contour-field--${place}`, className]}
  viewBox={set.viewBox}
  fill="none"
  aria-hidden="true"
>
  <g class="contour-wash">
    {
      set.paths.map((d, i) => (
        <path
          d={d}
          pathLength="1"
          vector-effect="non-scaling-stroke"
          class:list={["contour", { "contour--index": i % 4 === 0 }]}
          style={`--i: ${i}`}
        />
      ))
    }
    {set.trail && (
      <path
        class="contour-trail"
        d={set.trail}
        pathLength="100"
        vector-effect="non-scaling-stroke"
      />
    )}
  </g>
  <path
    class="contour-peak"
    vector-effect="non-scaling-stroke"
    d={`M ${peakX - 7} ${peakY} h 14 M ${peakX} ${peakY - 7} v 14`}
  />
  {
    set.marks.map((m) => {
      const mx = Number(m.x);
      const my = Number(m.y);
      const flip = mx > 0.72 * vbW;
      return (
        <g class="contour-submark">
          <path
            vector-effect="non-scaling-stroke"
            d={`M ${mx - 5} ${my} h 10 M ${mx} ${my - 5} v 10`}
          />
          <text
            class="contour-sublabel"
            x={flip ? mx - 12 : mx + 12}
            y={my + 4}
            text-anchor={flip ? "end" : "start"}
          >
            {m.ft}
          </text>
        </g>
      );
    })
  }
  {labeled && (
    <text class="contour-label" x={labelX} y={labelY}>
      {set.label}
    </text>
  )}
</svg>

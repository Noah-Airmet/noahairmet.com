---
import "../../styles/work.css";
import "../../styles/prose.css";
import { getCollection, render } from "astro:content";
import Page from "../../layouts/Page.astro";
import { isoDate, longDate } from "../../site";

export async function getStaticPaths() {
  const notes = await getCollection("writing");
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
---

<Page here="writing" title={note.data.title} description={note.data.description} path={`/writing/${note.id}/`}>
  <main id="main" class="page">
    <article>
      <header class="article-head">
        <h1 class="title page-title">{note.data.title}</h1>
        <p class="say">{note.data.description}</p>
        <time datetime={isoDate(note.data.date)}>{longDate(note.data.date)}</time>
      </header>
      <div class="prose">
        <Content />
      </div>
    </article>
  </main>
</Page>

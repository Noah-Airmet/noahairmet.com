---
import ContourField from "../components/ContourField.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const description = "Nothing is charted at this address.";
---

<BaseLayout title="Off the map" description={description} path="/404" noindex>
  <ContourField mountain="kingsPeak" place="bl" labelPos={[0.12, 0.13]} class="lost-art" />

  <div class="shell lost">
    <main id="main">
      <h1>Off the map</h1>
      <p>Nothing is charted at this address.</p>
      <nav class="cta-row" aria-label="Return">
        <a href="/"><span class="bracket" aria-hidden="true">[&nbsp;</span>back
        home<span class="bracket" aria-hidden="true">&nbsp;]</span></a>
      </nav>
    </main>
  </div>
</BaseLayout>

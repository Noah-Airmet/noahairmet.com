---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const description = "There is no page at this address.";
---

<BaseLayout title="Page not found" description={description} path="/404" noindex>
  <SiteHeader />

  <main id="main" class="wrap page lost">
    <h1 class="page-title">Page not found</h1>
    <p>
      There is no page at this address. The <a href="/">home page</a> links to everything on this
      site, and all writing is listed under <a href="/field-notes/">Writing</a>.
    </p>
  </main>

  <SiteFooter />
</BaseLayout>

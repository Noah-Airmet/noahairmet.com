---
import { getCollection } from "astro:content";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isoDate, longDate } from "../../lib/site";

const notes = (await getCollection("fieldNotes")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout
  title="Writing"
  description="Essays and notes by Noah Airmet on security and AI governance."
  path="/field-notes/"
>
  <SiteHeader current="writing" />

  <main id="main" class="wrap page">
    <h1 class="page-title">Writing</h1>

    <ol class="entries" role="list">
      {
        notes.map((note) => (
          <li class="entry">
            <h2 class="entry-title">
              <a href={`/field-notes/${note.id}/`}>{note.data.title}</a>
            </h2>
            <p class="entry-summary">{note.data.description}</p>
            <time class="entry-date" datetime={isoDate(note.data.date)}>
              {longDate(note.data.date)}
            </time>
          </li>
        ))
      }
    </ol>
  </main>

  <SiteFooter />
</BaseLayout>

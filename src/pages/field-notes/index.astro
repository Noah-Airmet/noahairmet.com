---
import { getCollection } from "astro:content";
import Benchmark from "../../components/Benchmark.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { noteNumber, plateDate } from "../../lib/site";

const notes = (await getCollection("fieldNotes")).sort(
  (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
);
const newestFirst = [...notes].reverse();
---

<BaseLayout
  title="Field notes"
  description="A chronological log of notes from studying AI governance and security."
  path="/field-notes/"
>
  <div class="shell">
    <nav class="crumb cta-row" aria-label="Breadcrumb">
      <a href="/"><span class="bracket" aria-hidden="true">[&nbsp;</span>← home<span
        class="bracket"
        aria-hidden="true"
      >&nbsp;]</span></a>
    </nav>

    <main id="main">
      <header class="note-head">
        <h1>Field notes</h1>
        <p class="note-lede">Numbered in the order they happened.</p>
      </header>

      <ol class="note-list" reversed>
        {
          newestFirst.map((note) => (
            <li class="note-row">
              <span class="chip">{noteNumber(notes.indexOf(note))}</span>
              <time class="note-date" datetime={note.data.date.toISOString().slice(0, 10)}>
                {plateDate(note.data.date)}
              </time>
              <a class="note-title" href={`/field-notes/${note.id}/`}>
                {note.data.title}
              </a>
            </li>
          ))
        }
      </ol>
    </main>

    <footer class="colophon">
      <p>Hand-built with Astro and plain CSS, with AI assistance. No analytics, no tracking.</p>
      <p class="stamp"><Benchmark /> 4,551 ft · Provo, Utah</p>
    </footer>
  </div>
</BaseLayout>

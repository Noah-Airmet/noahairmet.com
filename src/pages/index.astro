---
import "../styles/home.css";
import "../styles/work.css";
import { getCollection } from "astro:content";
import bench from "../data/citationbench.json";
import peaks from "../data/peaks.json";
import { asks } from "../data/asks";
import { quotes } from "../data/quotes";
import Page from "../layouts/Page.astro";
import Icon from "../components/Icon.astro";
import { isoDate, longDate, site } from "../site";

const notes = (await getCollection("writing")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const measures = [
  { id: "correct", name: "Correct", says: "The verdict is right, a cited page is a gold page, and code rejects no citation." },
  { id: "page_precision", name: "Page precision", says: "Of the pages an agent cited, the share that are gold pages." },
  { id: "quote_fidelity", name: "Quote fidelity", says: "Of the quotations an agent gave, the share whose words are on the page it cited." },
] as const;
const half = (v: number[]) => Math.round((v[2] - v[1]) / 2);
const first = quotes[0];
// The verdict alone (does the source support the sentence?), on real citing sentences.
const realLo = Math.min(...bench.runs.map((r) => r.real));
const realHi = Math.max(...bench.runs.map((r) => r.real));
---

<Page here="home" board>
  <div class="status" slot="bar">
    <span class="last" id="last" aria-hidden="true"></span>
    <button class="state" id="state" type="button" data-state="ok" aria-expanded="false" aria-controls="log">
      <i></i><span>Intact</span>
    </button>
    <aside class="log" id="log" hidden aria-label="What was done to this page, and who put it right">
      <div class="log-list" id="log-list"></div>
      <p class="log-none">Nothing yet</p>
    </aside>
  </div>

  <main id="main">
    <section class="hero" id="top">
      <h1 class="name" id="name" aria-label="Noah Airmet">
        <span class="ln">Noah</span>
        <span class="ln">Airmet</span>
      </h1>
      <button class="sr-key" id="scatter" type="button">Scatter the letters</button>

      <ul class="roles">
        <li>
          <span data-keep="a role">Pentesting and AI safety policy</span>
          <a href={site.simplicity}>Simplicity Group</a>
          <p class="what" data-keep="a role">
            Pen test remediation, SOC 2 compliance, AI vendor risk
          </p>
        </li>
        <li>
          <span data-keep="a role">Lead Technical Fellow</span>
          <a href={site.mta}>@transfigurism</a>
        </li>
        <li>
          <span data-keep="a role">Cybersecurity, class of 2027</span>
          <a href={site.byu}>BYU</a>
        </li>
      </ul>

      <div class="foot">
        <p class="lede" id="lede" data-keep="the lede">I’m working toward a career securing and governing AI systems.</p>
        <nav class="links" aria-label="Elsewhere">
          <a href={site.resume}><Icon name="file" />Résumé</a>
          <a href={`mailto:${site.email}`}><Icon name="mail" />Email</a>
          <a class="mark" href={site.github} aria-label="GitHub" title="GitHub"><Icon name="github" /></a>
          <a class="mark" href={site.linkedin} aria-label="LinkedIn" title="LinkedIn"><Icon name="linkedin" /></a>
          <a class="mark" href={site.x} aria-label="X" title="X"><Icon name="x" /></a>
        </nav>
      </div>
    </section>

    <div id="work">
      <section class="proj" id="citationbench" aria-labelledby="cb-h">
        <header class="proj-head">
          <h2 class="title" id="cb-h" data-keep="a heading">CitationBench</h2>
          <p class="say pitch" data-keep="a description">
            Agents cite sources in everything they write now. Give one a real library and it stops inventing them, but
            they still misread the source at an alarming rate. On real citations from published papers the agents we
            ran were right {realLo} to {realHi}% of the time.
          </p>
          <nav class="proj-links" aria-label="CitationBench">
            <a href={site.citationbench}>Leaderboard</a>
            <a href={`${site.safetypage}/r`}>Replays</a>
            <a href={`${site.safetypageRepo}/tree/main/citationbench`}>Method</a>
          </nav>
        </header>

        <div class="stage bench-stage" data-tilt>
          <figure class="slab check" id="check" data-depth="1">
            <blockquote class="q-wrap">
              <p class="q" id="q" spellcheck="false" aria-label="A quotation to check. Edit it.">{first.text}</p>
              <div class="q-marks" id="q-marks" aria-hidden="true"></div>
            </blockquote>
            <figcaption class="check-foot">
              <output class="verdict" id="verdict" data-v="ok" for="q"><i></i><span>On the page</span></output>
              <a class="src" id="q-src" href={first.href}>{first.source}</a>
              <button class="next" id="q-next" type="button"><span>Another</span><i class="timer" aria-hidden="true"></i></button>
              <span class="why" id="q-why"></span>
            </figcaption>
          </figure>

          <figure class="slab bench" id="bench" data-depth="1.7" aria-labelledby="bench-says">
            <div class="seg" role="group" aria-label="Measure">
              {
                measures.map((m, i) => (
                  <button type="button" data-m={m.id} data-says={m.says} aria-pressed={i === 0 ? "true" : "false"}>
                    {m.name}
                  </button>
                ))
              }
            </div>
            <ol class="rows">
              {
                bench.runs.map((r) => (
                  <li
                    class="row"
                    data-id={r.model}
                    data-correct={r.correct.join(" ")}
                    data-page_precision={r.page_precision.join(" ")}
                    data-quote_fidelity={r.quote_fidelity.join(" ")}
                  >
                    <div class="who">
                      <b>{r.model}</b>
                      <span>{r.agent}</span>
                    </div>
                    <div class="track">
                      <i class="fill" />
                      <i class="ci" />
                      <i class="grip" aria-hidden="true" />
                      <span class="val">
                        <b>{Math.round(r.correct[0])}</b>
                        <i>±{half(r.correct)}</i>
                      </span>
                    </div>
                  </li>
                ))
              }
            </ol>
            <figcaption class="says" id="bench-says">{measures[0].says}</figcaption>
          </figure>
        </div>
      </section>

      <section class="proj" id="catchword" aria-labelledby="cw-h">
        <header class="proj-head">
          <h2 class="title" id="cw-h" data-keep="a heading">Catchword</h2>
          <p class="say pitch" data-keep="a description">
            AI safety guidance comes out faster than anybody can read it, and agents are the ones quoting it now.
            Catchword is your entire library of safety documentation and AI policy writing, built to help you stay on
            top of it and in the loop.
          </p>
          <p class="points-head" data-keep="a line">
            A chatbot with web search can find many of the same documents, but Catchword is built for professionals
            because:
          </p>
          <ul class="points">
            <li>
              <b data-keep="a point">Cited to the page</b>
              <span>A citation opens the exact page, with the quoted words marked.</span>
            </li>
            <li>
              <b data-keep="a point">Quotes checked</b>
              <span>Each quote is compared word for word with the page it cites.</span>
            </li>
            <li>
              <b data-keep="a point">Every version kept</b>
              <span>Drafts and revisions stay separate sources. Ten versions of Anthropic’s Responsible Scaling Policy.</span>
            </li>
            <li>
              <b data-keep="a point">One library</b>
              <span>13,898 documents: papers, system cards, safety frameworks, government guidance, evaluator reports.</span>
            </li>
          </ul>
          <nav class="proj-links" aria-label="Catchword">
            <a href={site.safetypage}>Library</a>
            <a href={site.safetypageRepo}>GitHub</a>
          </nav>
        </header>

        <div class="stage ask-stage" data-tilt>
          <a class="slab sheet" id="sheet" data-depth="1" href={asks[0].href} aria-label="The cited page, on Catchword">
            <span class="sheet-in" id="sheet-in">
              <img id="sheet-img" src={asks[0].page.img} width={asks[0].page.w} height={asks[0].page.h} alt={`${asks[0].title}, the cited page`} />
            </span>
          </a>

          <figure class="slab ask" id="ask" data-depth="1.7">
            <div class="ask-set">
              {
                asks.map((a, i) => (
                  <div class:list={["ask-item", { on: i === 0 }]}>
                    <p class="ask-q">
                      <span class="ask-text"><span class="ask-typed">{a.ask}</span><span class="ask-rest" /></span>
                      <i class="ask-send" aria-hidden="true">↵</i>
                    </p>
                    <p class="ask-lead">{a.lead}</p>
                    <blockquote class="ask-quote" cite={a.href}>{a.quote}</blockquote>
                  </div>
                ))
              }
            </div>
            <figcaption class="check-foot">
              <output class="verdict" id="ask-verdict" data-v="ok"><i></i><span>On the page</span></output>
              <a class="src" id="ask-src" href={asks[0].href}>{asks[0].source}</a>
              <button class="next" id="ask-next" type="button"><span>Another</span><i class="timer" aria-hidden="true"></i></button>
            </figcaption>
          </figure>
        </div>
      </section>
    </div>

    <section class="writing" id="writing" aria-labelledby="w-h">
      <h2 class="title" id="w-h" data-keep="a heading">Writing</h2>
      <ol class="notes">
        {
          notes.map((n) => (
            <li>
              <a href={`/writing/${n.id}/`}>
                <span class="note-title">{n.data.title}</span>
                <time datetime={isoDate(n.data.date)}>{longDate(n.data.date)}</time>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="outside" id="outside" aria-labelledby="o-h">
      <h2 id="o-h" class="sr">Outside</h2>
      <figure class="peak">
        <canvas id="peak" role="img" aria-label="A Utah mountain as stacked contour lines, with a trail drawn on it"></canvas>
        <figcaption>
          <span class="peak-name" id="peak-name">Mount Timpanogos</span>
          <span class="peak-meta" id="peak-meta">{peaks.peaks[0].trail}, {peaks.peaks[0].trail_mi.toFixed(1)} mi</span>
        </figcaption>
        <div class="seg peaks" id="peaks" role="group" aria-label="Mountain" hidden>
          {
            peaks.peaks.map((p, i) => (
              <button type="button" data-key={p.key} data-name={p.name} aria-pressed={i === 0 ? "true" : "false"}>
                {p.name.replace(/^Mount /, "")}
              </button>
            ))
          }
        </div>
        <small class="credit">
          Elevation: U.S. Geological Survey, 3D Elevation Program. Trails
          <a href="https://www.openstreetmap.org/copyright">© OpenStreetMap contributors</a>.
        </small>
      </figure>
    </section>
  </main>

  <section class="sky" id="sky" aria-label="The time of day in Provo" hidden>
    <div class="day-head">
      <span class="day-where">Provo</span>
      <b id="day-time"></b>
      <span id="day-what"></span>
      <button class="day-now" id="day-now" type="button" hidden>Now</button>
    </div>
    <div
      class="daybar"
      id="daybar"
      role="slider"
      tabindex="0"
      aria-label="Time of day in Provo, Utah"
      aria-valuemin="0"
      aria-valuemax="1439"
      aria-valuenow="720"
    >
      <div class="day-strip"></div>
      <i class="day-mark"></i>
      <div class="day-scale" aria-hidden="true">
        <span class="day-hour h0">12 AM</span>
        <span class="day-hour h6">6</span>
        <span class="day-hour h12">Noon</span>
        <span class="day-hour h18">6</span>
        <span class="day-hour h24">12 AM</span>
      </div>
    </div>
  </section>

  <footer class="colophon">
    <a class="col-mail" href={`mailto:${site.email}`}><Icon name="mail" />{site.email}</a>
    <nav class="links" aria-label="Contact">
      <a href={site.resume}><Icon name="file" />Résumé</a>
      <a class="mark" href={site.github} aria-label="GitHub" title="GitHub"><Icon name="github" /></a>
      <a class="mark" href={site.linkedin} aria-label="LinkedIn" title="LinkedIn"><Icon name="linkedin" /></a>
      <a class="mark" href={site.x} aria-label="X" title="X"><Icon name="x" /></a>
    </nav>
  </footer>
</Page>

<script>
  import "../board/main.ts";
</script>

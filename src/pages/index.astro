---
import { getCollection } from "astro:content";
import PeakMark from "../components/PeakMark.astro";
import ContourField from "../components/ContourField.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { noteNumber, plateDate, site } from "../lib/site";

const notes = (await getCollection("fieldNotes")).sort(
  (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
);
const recent = notes.slice(-5).reverse();

const links = [
  { label: "résumé", href: site.resume },
  { label: "github", href: site.github },
  { label: "linkedin", href: site.linkedin },
  { label: "email", href: `mailto:${site.email}` },
  { label: "rss", href: "/rss.xml" },
];
---

<BaseLayout>
  <ContourField mountain="timpanogos" place="tr" labelPos={[0.26, 0.72]} />
  <ContourField mountain="lonePeak" place="bl" labelPos={[0.16, 0.44]} class="home-knoll" />

  <div class="shell">
    <header class="masthead-block">
      <div class="masthead">
        <PeakMark />
        <h1 class="masthead-name">Noah Airmet</h1>
      </div>
      <p class="plate-line">Provo, Utah · BYU cybersecurity · class of 2028</p>
    </header>

    <main id="main">
      <p class="bio">
        I'm a cybersecurity student at BYU and a junior developer at <a
          href="https://www.simplicitygroup.com/"
        >Simplicity Group</a>. I'm working
        toward technical AI governance: threat-modeling AI systems, running evals,
        and writing documentation a regulator or auditor can actually use. I'm early
        on that trail; these notes are me learning in public.
      </p>

      <section class="section" aria-labelledby="notes-label">
        <h2 class="section-label" id="notes-label">Field notes</h2>
        <ol class="note-list" reversed>
          {
            recent.map((note) => (
              <li class="note-row">
                <span class="chip">{noteNumber(notes.indexOf(note))}</span>
                <time class="note-date" datetime={note.data.date.toISOString().slice(0, 10)}>
                  {plateDate(note.data.date)}
                </time>
                <a class="note-title" href={`/field-notes/${note.id}/`}>
                  {note.data.title}
                </a>
              </li>
            ))
          }
        </ol>
        {
          notes.length > recent.length && (
            <p class="note-aside">
              <a href="/field-notes/">All {notes.length} notes →</a>
            </p>
          )
        }
      </section>

      <nav class="section" aria-label="Primary links">
        <ul class="cta-row" role="list">
          {
            links.map((link) => (
              <li>
                <a href={link.href}>
                  <span class="bracket" aria-hidden="true">[&nbsp;</span>{link.label}<span
                    class="bracket"
                    aria-hidden="true"
                  >&nbsp;]</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <section class="section" aria-labelledby="elsewhere-label">
        <h2 class="section-label" id="elsewhere-label">Elsewhere</h2>
        <p class="bio">
          I also build <a href="https://pulpit-archive.org/">Pulpit</a>, an
          AI-assisted archive of Latter-day Saint general conference sermons with
          source-linked transcription and human review. It's independent from my
          professional work, but it's where I learned to run systems carefully.
        </p>
      </section>
    </main>

    <footer class="colophon">
      <p>Hand-built with Astro and plain CSS, with AI assistance. No analytics, no tracking.</p>
      <p class="stamp"><PeakMark /> 4,551 ft · Provo, Utah</p>
    </footer>
  </div>
</BaseLayout>

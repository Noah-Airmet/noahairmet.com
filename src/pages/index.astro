---
import Bracket from "../components/Bracket.astro";
import Site from "../layouts/Site.astro";
import { site } from "../lib/site";
---

<Site tab="about" bareBar class="page-about">
  <main id="main" class="about">
    <section class="intro" aria-labelledby="name">
      <h1 class="name" id="name">Noah<br />Airmet</h1>
      <p class="lede">
        I study cybersecurity at BYU and build software at{" "}
        <a href="https://www.simplicitygroup.com/">Simplicity Group</a>. I’m working toward a career
        securing and governing AI systems.
      </p>
      <nav class="actions" aria-label="Résumé and contact">
        <Bracket href={site.resume}>résumé</Bracket>
        <Bracket href={`mailto:${site.email}`}>email</Bracket>
        <Bracket href={site.github}>github</Bracket>
        <Bracket href={site.linkedin}>linkedin</Bracket>
      </nav>
      <p class="also">
        Also building <a href={site.agentBus}>agent-bus</a>, a small tool that lets AI coding
        assistants hand work to each other.
      </p>
    </section>

    <figure class="timp">
      <canvas id="timp" role="img" aria-label="Mount Timpanogos, drawn as ridgelines from USGS elevation data"></canvas>
      <figcaption class="caption">
        <span class="caption-title">Mount Timpanogos</span>
        <span class="caption-meta">11,749 ft, above Provo, Utah</span>
        <span class="caption-time">
          <span id="clock">&nbsp;</span>
          <span
            class="daybar"
            id="daybar"
            role="slider"
            tabindex="0"
            aria-label="Time of day in Provo"
            aria-valuemin="0"
            aria-valuemax="1439"
          >
            <span class="sun"></span>
          </span>
        </span>
      </figcaption>
    </figure>
  </main>
</Site>

<script>
  import "../scripts/timp.ts";
</script>

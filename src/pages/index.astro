---
import "../styles/home.css";
import "../styles/work.css";
import { getCollection } from "astro:content";
import bench from "../data/citationbench.json";
import { quotes } from "../data/quotes";
import Page from "../layouts/Page.astro";
import Icon from "../components/Icon.astro";
import { isoDate, longDate, site } from "../site";

const notes = (await getCollection("writing")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const measures = [
  { id: "correct", name: "Correct", says: "The verdict is right, a cited page is a gold page, and code rejects no citation." },
  { id: "page_precision", name: "Page precision", says: "Of the pages an agent cited, the share that are gold pages." },
  { id: "quote_fidelity", name: "Quote fidelity", says: "Of the quotations an agent gave, the share whose words are on the page it cited." },
] as const;
const half = (v: number[]) => Math.round((v[2] - v[1]) / 2);
const first = quotes[0];
// The verdict alone: on errors the benchmark planted, and on real citing sentences.
const planted = Math.min(...bench.runs.map((r) => r.planted));
const realLo = Math.min(...bench.runs.map((r) => r.real));
const realHi = Math.max(...bench.runs.map((r) => r.real));
// The run the recording shows (public/media/citationbench-replay.mp4).
const replay = "/r/cc-haiku-5-5-4e1c63-pc-4bd058594c.1";
---

<Page here="home" board>
  <div class="status" slot="bar">
    <span class="last" id="last" aria-hidden="true"></span>
    <button class="state" id="state" type="button" data-state="ok" aria-expanded="false" aria-controls="log">
      <i></i><span>Intact</span>
    </button>
    <aside class="log" id="log" hidden aria-label="What was done to this page, and who put it right">
      <div class="log-list" id="log-list"></div>
      <p class="log-none">Nothing yet</p>
    </aside>
  </div>

  <main id="main">
    <section class="hero" id="top">
      <h1 class="name" id="name" aria-label="Noah Airmet">
        <span class="ln">Noah</span>
        <span class="ln">Airmet</span>
      </h1>
      <button class="sr-key" id="scatter" type="button">Scatter the letters</button>

      <ul class="roles">
        <li>
          <span data-keep="a role">Pentesting and AI safety policy</span>
          <a href={site.simplicity}>Simplicity Group</a>
        </li>
        <li>
          <span data-keep="a role">Lead Technical Fellow</span>
          <a href={site.mta}>@transfigurism</a>
        </li>
        <li>
          <span data-keep="a role">Cybersecurity, class of 2027</span>
          <a href={site.byu}>BYU</a>
        </li>
      </ul>

      <div class="foot">
        <p class="lede" id="lede" data-keep="the lede">I’m working toward a career securing and governing AI systems.</p>
        <nav class="links" aria-label="Elsewhere">
          <a href={site.resume}><Icon name="file" />Résumé</a>
          <a href={`mailto:${site.email}`}><Icon name="mail" />Email</a>
          <a class="mark" href={site.github} aria-label="GitHub" title="GitHub"><Icon name="github" /></a>
          <a class="mark" href={site.linkedin} aria-label="LinkedIn" title="LinkedIn"><Icon name="linkedin" /></a>
          <a class="mark" href={site.x} aria-label="X" title="X"><Icon name="x" /></a>
        </nav>
      </div>
    </section>

    <div id="work">
      <section class="proj" id="citationbench" aria-labelledby="cb-h">
        <header class="proj-head">
          <h2 class="title" id="cb-h" data-keep="a heading">CitationBench</h2>
          <p class="say" data-keep="a description">
            Every agent we tried caught {planted}% of the errors we planted, and between {realLo} and {realHi}% of the
            real ones sitting in published papers.
          </p>
          <nav class="proj-links" aria-label="CitationBench">
            <a href={site.citationbench}>Leaderboard</a>
            <a href={`${site.safetypage}/r`}>Replays</a>
            <a href={`${site.safetypageRepo}/tree/main/citationbench`}>Method</a>
          </nav>
        </header>

        <div class="stage bench-stage" data-tilt>
          <a class="slab replay" data-depth="1" href={`${site.safetypage}${replay}`} aria-label="A CitationBench run, replayed. Open it on SafetyPage">
            <video
              id="replay"
              muted
              loop
              playsinline
              preload="metadata"
              poster="/media/citationbench-replay.webp"
              width="1200"
              height="750"
            >
              <source src="/media/citationbench-replay.mp4" type="video/mp4" />
            </video>
          </a>

          <figure class="slab bench" id="bench" data-depth="1.7" aria-labelledby="bench-says">
            <div class="seg" role="group" aria-label="Measure">
              {
                measures.map((m, i) => (
                  <button type="button" data-m={m.id} data-says={m.says} aria-pressed={i === 0 ? "true" : "false"}>
                    {m.name}
                  </button>
                ))
              }
            </div>
            <ol class="rows">
              {
                bench.runs.map((r) => (
                  <li
                    class="row"
                    data-id={r.model}
                    data-correct={r.correct.join(" ")}
                    data-page_precision={r.page_precision.join(" ")}
                    data-quote_fidelity={r.quote_fidelity.join(" ")}
                  >
                    <div class="who">
                      <b>{r.model}</b>
                      <span>{r.agent}</span>
                    </div>
                    <div class="track">
                      <i class="fill" />
                      <i class="ci" />
                      <i class="grip" aria-hidden="true" />
                      <span class="val">
                        <b>{Math.round(r.correct[0])}</b>
                        <i>±{half(r.correct)}</i>
                      </span>
                    </div>
                  </li>
                ))
              }
            </ol>
            <figcaption class="says" id="bench-says">{measures[0].says}</figcaption>
          </figure>
        </div>
      </section>

      <section class="proj" id="safetypage" aria-labelledby="sp-h">
        <header class="proj-head">
          <h2 class="title" id="sp-h" data-keep="a heading">SafetyPage</h2>
          <p class="say" data-keep="a description">
            A page-cited library of the AI safety record, built for people and for AI agents.
          </p>
          <nav class="proj-links" aria-label="SafetyPage">
            <a href={site.safetypage}>Library</a>
            <a href={site.safetypageRepo}>GitHub</a>
          </nav>
        </header>

        <div class="stage check-stage" data-tilt>
          <a class="slab sheet" id="sheet" data-depth="1" href={first.href} aria-label="The cited page, on SafetyPage">
            <span class="sheet-in" id="sheet-in">
              <img id="sheet-img" src={first.page.img} width={first.page.w} height={first.page.h} alt={`${first.title}, the cited page`} />
            </span>
          </a>

          <figure class="slab check" id="check" data-depth="1.7">
            <blockquote class="q-wrap">
              <p class="q" id="q" spellcheck="false" aria-label="A quotation to check. Edit it.">{first.text}</p>
              <div class="q-marks" id="q-marks" aria-hidden="true"></div>
            </blockquote>
            <figcaption class="check-foot">
              <output class="verdict" id="verdict" data-v="ok" for="q"><i></i><span>On the page</span></output>
              <a class="src" id="q-src" href={first.href}>{first.source}</a>
              <button class="next" id="q-next" type="button"><span>Another</span><i class="timer" aria-hidden="true"></i></button>
              <span class="why" id="q-why"></span>
            </figcaption>
          </figure>
        </div>
      </section>
    </div>

    <section class="writing" id="writing" aria-labelledby="w-h">
      <h2 class="title" id="w-h" data-keep="a heading">Writing</h2>
      <ol class="notes">
        {
          notes.map((n) => (
            <li>
              <a href={`/writing/${n.id}/`}>
                <span class="note-title">{n.data.title}</span>
                <time datetime={isoDate(n.data.date)}>{longDate(n.data.date)}</time>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="outside" id="outside" aria-labelledby="o-h">
      <h2 id="o-h" class="sr">Outside</h2>
      <figure class="peak">
        <canvas id="peak" role="img" aria-label="A Utah mountain as stacked contour lines, with a trail drawn on it"></canvas>
        <figcaption>
          <span class="peak-name" id="peak-name">Mount Timpanogos</span>
          <span class="peak-meta" id="peak-meta">Wasatch Range, Utah</span>
        </figcaption>
        <div class="seg peaks" id="peaks" role="group" aria-label="Mountain" hidden></div>
        <small class="credit">Elevation from USGS 3DEP. Trails © OpenStreetMap contributors.</small>
      </figure>
    </section>
  </main>

  <footer class="colophon">
    <a class="col-mail" href={`mailto:${site.email}`}><Icon name="mail" />{site.email}</a>
    <nav class="links" aria-label="Contact">
      <a href={site.resume}><Icon name="file" />Résumé</a>
      <a class="mark" href={site.github} aria-label="GitHub" title="GitHub"><Icon name="github" /></a>
      <a class="mark" href={site.linkedin} aria-label="LinkedIn" title="LinkedIn"><Icon name="linkedin" /></a>
      <a class="mark" href={site.x} aria-label="X" title="X"><Icon name="x" /></a>
    </nav>
  </footer>
</Page>

<script>
  import "../board/main.ts";
</script>

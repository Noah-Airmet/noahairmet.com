---
// The share card's stage: the name, the page's state and the agents, sized
// for a link preview (480x252, which scripts/card.mjs records at 2.5x). It is
// the same board as the home page, so the letters can be thrown here too.
import Page from "../layouts/Page.astro";
import "../styles/home.css";
import "../styles/card.css";
---

<Page title="Card" path="/card/" noindex board>
  <div class="status" slot="bar">
    <button class="state" id="state" type="button" data-state="ok">
      <i></i><span>Intact</span>
    </button>
  </div>

  <main id="main" class="card">
    <section class="hero" id="top">
      <h1 class="name" id="name" aria-label="Noah Airmet">
        <span class="ln">Noah</span>
        <span class="ln">Airmet</span>
      </h1>
      <button class="sr-key" id="scatter" type="button">Scatter the letters</button>
    </section>
  </main>
</Page>

<script>
  import "../board/card.ts";
</script>

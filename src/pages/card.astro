---
// The share card (/card/): the name and what he does, composed at 1200 by 630
// for a link preview. `node scripts/card.mjs` photographs it into
// public/og/card.png.
import Page from "../layouts/Page.astro";
import "../styles/home.css";
import "../styles/card.css";
---

<Page title="Card" path="/card/" noindex>
  <main id="main" class="card">
    <h1 class="name" aria-label="Noah Airmet">
      <span class="ln">Noah Airmet</span>
    </h1>
    <p class="card-lede">Securing and governing AI systems.</p>
    <ul class="card-roles">
      <li><b>Development and AI Security</b> Simplicity Group</li>
      <li><b>Lead Technical Fellow</b> @transfigurism</li>
      <li><b>Cybersecurity</b> BYU</li>
    </ul>
  </main>
</Page>
